# ==========================================
# Selftaught - Environment Variables Template
# ==========================================

# Backend Configuration
ENVIRONMENT=development
DEBUG=True
PROJECT_NAME="Selftaught"
API_V1_STR="/api/v1"

# Security (Generate a strong random key in production: openssl rand -hex 32)
SECRET_KEY="selftaught-insecure-secret-key-change-in-production-only-for-dev"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# Production (PostgreSQL / Supabase):
# DATABASE_URL="postgresql+asyncpg://postgres:password@localhost:5432/selftaught"
# Local development default (SQLite fallback):
DATABASE_URL="sqlite+aiosqlite:///./selftaught.db"

# CORS Allowed Origins (Comma separated)
BACKEND_CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Frontend Configuration
NEXT_PUBLIC_API_URL="http://127.0.0.1:8000/api/v1"
