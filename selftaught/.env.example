### Exemplo de arquivo de variáveis de ambiente para produção
# URL do banco Supabase (PostgreSQL)
DATABASE_URL=postgresql://<usuario>:<senha>@<host>.supabase.co:5432/<db_name>

# Segredo para assinatura JWT
JWT_SECRET=super_secret_key_change_me

# Porta opcional (Vercel usa porta 0)
API_PORT=8000

# URL pública do backend (usada pelo frontend)
NEXT_PUBLIC_API_URL=https://<seu-projeto>.vercel.app/api
