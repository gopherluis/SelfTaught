{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  
  "services": {
    "backend": {
      "root": "backend",
      "framework": "fastapi"
    },
    "frontend": {
      "root": "frontend",
      "framework": "nextjs",
      "outputDirectory": ".next",
      "bindings": [
        {
          "type": "service",
          "service": "backend",
          "format": "url",
          "env": "INTERNAL_BACKEND_URL"
        }
      ]
    }
  },
  "routes": [
    {
      "src": "^/api/(.*)$",
      "dest": "backend"
    },
    {
      "src": "^(.*)$",
      "dest": "frontend"
    }
  ]
}
